        <a href="YOUR_LINKEDIN_URL" target="_blank" title="LinkedIn">
          <i class="fa-brands fa-linkedin"></i>
        </a>

        <a href="mailto:YOUR_EMAIL@gmail.com" title="Email">
          <i class="fa-solid fa-envelope"></i>
        </a>
      </div>

    </div>
  </div>
</nav>

<main>

  <h1>Projects</h1>

  <p class="page-description">
    Selected research and transportation planning projects.
  </p>

  <div class="project-grid">


    <div class="project-card">

      <div class="project-category">
        Urban Railway Planning
      </div>

      <h2>
        Seoul Urban Railway Network Planning
      </h2>

      <p>
        Feasibility and network planning analysis for proposed urban railway
        corridors in Seoul, including travel demand, accessibility,
        connectivity, and spatial analysis.
      </p>

      <div class="project-methods">
        GIS · OD Analysis · Accessibility · Feasibility Assessment
      </div>

    </div>


    <div class="project-card">

      <div class="project-category">
        Sustainable Transportation
      </div>

      <h2>
        Sustainable Urban Transport Strategy for Bishkek
      </h2>

      <p>
        Development of mid- and long-term transportation strategies
        supporting sustainable and carbon-neutral urban mobility in
        Bishkek, Kyrgyzstan.
      </p>

      <div class="project-methods">
        Transport Planning · Policy Analysis · International Cooperation
      </div>

    </div>


    <div class="project-card">

      <div class="project-category">
        Multimodal Mobility
      </div>

      <h2>
        Public Transport–Bike Transfer Efficiency
      </h2>

      <p>
        Evaluation of multimodal transfer efficiency between public
        transportation and bike-sharing using mobility and spatial data.
      </p>

      <div class="project-methods">
        Smartcard Data · Bike-Sharing Data · GIS · Transfer Analysis
      </div>

    </div>


    <div class="project-card">

      <div class="project-category">
        Transportation Safety
      </div>

      <h2>
        Freeway Ramp Influence and Safety Analysis
      </h2>

      <p>
        Identification of freeway ramp influence areas using vehicle
        trajectory data and surrogate safety measures.
      </p>

      <div class="project-methods">
        NGSIM · TTC · DRAC · SDI · Traffic Safety Analysis
      </div>

    </div>

  </div>

</main>

