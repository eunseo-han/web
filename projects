  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      color: #222;
      background: white;
      line-height: 1.7;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    nav {
      border-bottom: 1px solid #e6e6e6;
      background: white;
    }

    .nav-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 18px 25px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .nav-name {
      font-size: 18px;
      font-weight: 700;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 30px;
    }

    .nav-links {
      display: flex;
      gap: 25px;
    }

    .nav-links a {
      font-size: 14px;
      color: #333;
    }

    .nav-links a:hover,
    .nav-links .active {
      color: #24557a;
    }

    .nav-links .active {
      font-weight: 600;
    }

    .social-icons {
      display: flex;
      gap: 15px;
      align-items: center;
    }

    .social-icons a {
      font-size: 18px;
      color: #444;
    }

    .social-icons a:hover {
      color: #24557a;
    }

    main {
      max-width: 1100px;
      margin: 0 auto;
      padding: 90px 25px;
    }

    h1 {
      font-size: 42px;
      margin-bottom: 10px;
      letter-spacing: -1px;
    }

    .page-description {
      color: #666;
      margin-bottom: 50px;
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .project-card {
      border: 1px solid #e6e6e6;
      border-radius: 10px;
      padding: 30px;
      transition: 0.2s;
    }

    .project-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
    }

    .project-category {
      color: #24557a;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .project-card h2 {
      font-size: 20px;
      margin: 8px 0 12px;
    }

    .project-card p {
      color: #555;
      font-size: 14px;
      margin-bottom: 14px;
    }

    .project-methods {
      font-size: 13px;
      color: #777;
    }

    @media (max-width: 750px) {
      .nav-links {
        display: none;
      }

      .project-grid {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 34px;
      }
    }
  </style>
</head>

<body>

<nav>
  <div class="nav-container">

    <a href="index.html" class="nav-name">Eun-Seo Han</a>

    <div class="nav-right">

